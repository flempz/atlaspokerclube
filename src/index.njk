<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Atlas Poker Clube — 50% Rakeback | KKPoker</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Manrope:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --gold:    #D4AF37;
    --gold2:   #E8C766;
    --gold3:   #F5DD9A;
    --black:   #0D0D0D;
    --dark:    #1A1A1A;
    --dark2:   #2D2D2D;
    --white:   #FFFFFF;
    --muted:   #9A9A9A;
    --red:     #E0544B;
    --font-display: 'Sora', sans-serif;
    --font-body:    'Manrope', sans-serif;
    --font-mono:    'DM Mono', monospace;
  }

  *,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
  html { scroll-behavior:smooth; }
  body {
    background: var(--black);
    color: var(--white);
    font-family: var(--font-body);
    font-size: 16px; line-height: 1.65;
    overflow-x: hidden;
  }

  body::before {
    content:'';
    position:fixed; inset:0;
    background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events:none; z-index:0; opacity:.5;
  }

  /* NAV */
  nav {
    position:fixed; top:0; width:100%; z-index:100;
    padding:14px 36px;
    display:flex; align-items:center; justify-content:space-between;
    background:rgba(13,13,13,.92);
    backdrop-filter:blur(14px);
    border-bottom:1px solid rgba(212,175,55,.18);
  }
  .nav-logo { display:flex; align-items:center; gap:10px; text-decoration:none; }
  .nav-logo img { height:38px; width:auto; }
  .nav-links { display:flex; gap:28px; align-items:center; }
  .nav-links a {
    color:var(--muted); text-decoration:none; font-size:13px; font-weight:500;
    letter-spacing:.4px; transition:color .2s;
  }
  .nav-links a:hover { color:var(--gold2); }
  .nav-cta {
    background:linear-gradient(135deg,var(--gold),var(--gold2));
    color:var(--black) !important; padding:10px 22px;
    border-radius:4px; font-weight:700 !important; font-size:12px !important;
    letter-spacing:.5px !important; text-transform:uppercase !important;
    transition:opacity .2s, transform .15s !important;
    box-shadow:0 4px 20px rgba(212,175,55,.3);
  }
  .nav-cta:hover { opacity:.9; transform:translateY(-1px); }

  section { position:relative; z-index:1; }
  .container { max-width:1100px; margin:0 auto; padding:0 32px; }

  /* HERO */
  #hero {
    min-height:100vh; display:flex; align-items:center; padding-top:80px;
    background:
      radial-gradient(ellipse 70% 60% at 65% 40%, rgba(212,175,55,.1) 0%, transparent 65%),
      radial-gradient(ellipse 45% 45% at 10% 85%, rgba(212,175,55,.05) 0%, transparent 60%),
      var(--black);
    overflow:hidden;
  }
  .hero-grid { display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center; padding:80px 0; }

  .hero-badge {
    display:inline-flex; align-items:center; gap:8px;
    background:rgba(212,175,55,.1); border:1px solid rgba(212,175,55,.35);
    border-radius:20px; padding:6px 16px;
    font-family:var(--font-mono); font-size:11px; color:var(--gold3);
    letter-spacing:2px; text-transform:uppercase; margin-bottom:22px;
  }
  .hero-dot { width:6px; height:6px; border-radius:50%; background:var(--gold2); animation:pulse 2s ease-in-out infinite; }
  @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.4;transform:scale(.7)} }

  .hero-h1 {
    font-family:var(--font-display); font-weight:800;
    font-size:clamp(46px,5.8vw,76px); line-height:1.02; letter-spacing:-.5px;
    margin-bottom:24px;
  }
  .hero-h1 .gold { color:var(--gold2); }

  .hero-sub { font-size:17px; color:var(--muted); line-height:1.7; margin-bottom:36px; max-width:460px; }

  .hero-stats { display:flex; gap:28px; margin-bottom:36px; }
  .hero-stat { border-left:3px solid var(--gold); padding-left:14px; }
  .hero-stat-num { font-family:var(--font-display); font-size:34px; font-weight:800; color:var(--gold2); line-height:1; }
  .hero-stat-label { font-size:11px; color:var(--muted); font-family:var(--font-mono); text-transform:uppercase; letter-spacing:1px; }

  .hero-ctas { display:flex; gap:14px; flex-wrap:wrap; }

  .btn-primary {
    background:linear-gradient(135deg,var(--gold),var(--gold2));
    color:var(--black); padding:16px 32px; border-radius:4px;
    font-weight:700; font-size:14px; text-decoration:none;
    letter-spacing:.4px; display:inline-block; transition:all .2s;
    box-shadow:0 6px 28px rgba(212,175,55,.3);
  }
  .btn-primary:hover { transform:translateY(-2px); box-shadow:0 10px 38px rgba(212,175,55,.4); }

  .btn-ghost {
    background:transparent; color:var(--gold2); padding:16px 32px;
    border-radius:4px; font-weight:600; font-size:14px; text-decoration:none;
    letter-spacing:.4px; border:1px solid rgba(212,175,55,.45);
    display:inline-block; transition:all .2s;
  }
  .btn-ghost:hover { background:rgba(212,175,55,.08); border-color:var(--gold2); }

  /* hero visual */
  .hero-visual { position:relative; display:flex; justify-content:center; align-items:center; }
  .hero-logo-wrap { position:relative; display:flex; justify-content:center; align-items:center; }
  .hero-logo {
    width:300px; height:auto;
    filter:drop-shadow(0 0 50px rgba(212,175,55,.3));
    animation:floatLogo 5s ease-in-out infinite;
  }
  @keyframes floatLogo { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-14px)} }

  .hero-card {
    position:absolute; background:rgba(26,26,26,.9);
    border:1px solid rgba(212,175,55,.25); border-radius:10px;
    padding:16px 20px; backdrop-filter:blur(10px);
  }
  .hero-card.tr { top:-10px; right:-30px; width:160px; animation:floatCard1 4s ease-in-out infinite; }
  .hero-card.bl { bottom:0; left:-30px; width:170px; animation:floatCard2 5s ease-in-out infinite reverse; }
  @keyframes floatCard1 { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }
  @keyframes floatCard2 { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }
  .hc-label { font-family:var(--font-mono); font-size:9px; color:var(--muted); letter-spacing:2px; text-transform:uppercase; margin-bottom:4px; }
  .hc-val { font-family:var(--font-display); font-size:28px; font-weight:800; color:var(--gold2); line-height:1; }
  .hc-sub { font-size:11px; color:var(--muted); margin-top:3px; }

  /* TAGS / TITLES */
  .tag { font-family:var(--font-mono); font-size:10px; color:var(--gold); letter-spacing:3px; text-transform:uppercase; margin-bottom:12px; display:block; }
  .section-title {
    font-family:var(--font-display); font-weight:800;
    font-size:clamp(34px,4.2vw,52px); line-height:1.04; letter-spacing:-.5px; margin-bottom:16px;
  }
  .section-title .gold { color:var(--gold2); }
  .section-lead { font-size:17px; color:var(--muted); line-height:1.65; max-width:540px; }
  .divider { width:48px; height:3px; background:var(--gold); margin:0 0 40px; }

  /* CONCEITO */
  #conceito { padding:120px 0; background:var(--dark); }
  .pillars { display:grid; grid-template-columns:repeat(3,1fr); gap:2px; margin-top:48px; border-radius:10px; overflow:hidden; }
  .pillar {
    background:var(--black); border:1px solid rgba(212,175,55,.12);
    padding:36px 28px; text-align:center; transition:border-color .2s;
  }
  .pillar:hover { border-color:rgba(212,175,55,.4); }
  .pillar-icon {
    width:56px; height:56px; border-radius:50%;
    background:rgba(212,175,55,.08); border:1px solid rgba(212,175,55,.3);
    display:flex; align-items:center; justify-content:center;
    font-size:24px; margin:0 auto 18px;
  }
  .pillar-title { font-family:var(--font-display); font-weight:700; font-size:18px; letter-spacing:1px; text-transform:uppercase; margin-bottom:10px; color:var(--gold2); }
  .pillar p { font-size:13px; color:var(--muted); line-height:1.6; }

  /* CLUBE / IDENTIDADE */
  #clube { padding:120px 0; background:var(--black); }
  .clube-grid { display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center; margin-top:56px; }
  .clube-logo-box {
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    background:var(--dark); border:1px solid rgba(212,175,55,.18);
    border-radius:12px; padding:48px 36px; position:relative; overflow:hidden;
  }
  .clube-logo-box::before { content:''; position:absolute; inset:0; background:radial-gradient(ellipse 80% 60% at 50% 50%, rgba(212,175,55,.06), transparent); }
  .clube-logo-box img { width:240px; height:auto; position:relative; z-index:1; }

  .clube-features { display:flex; flex-direction:column; gap:2px; }
  .cf { background:var(--dark); border:1px solid rgba(212,175,55,.12); border-radius:8px; padding:20px 24px; display:flex; gap:16px; align-items:flex-start; transition:border-color .2s; }
  .cf:hover { border-color:rgba(212,175,55,.4); }
  .cf-icon { width:38px; height:38px; border-radius:8px; background:rgba(212,175,55,.1); display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0; }
  .cf-t { font-size:14px; font-weight:600; color:var(--white); margin-bottom:4px; }
  .cf-p { font-size:13px; color:var(--muted); line-height:1.55; }

  /* RAKEBACK */
  #rakeback { padding:120px 0; background:var(--dark); }
  .rb-big { display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center; margin-top:56px; }
  .rb-visual {
    background:var(--black); border:1px solid rgba(212,175,55,.3);
    border-radius:14px; padding:48px 40px; text-align:center; position:relative; overflow:hidden;
  }
  .rb-visual::before { content:'♠'; position:absolute; top:-30px; right:10px; font-size:200px; color:rgba(212,175,55,.025); line-height:1; }
  .rb-pct {
    font-family:var(--font-display); font-size:120px; font-weight:800;
    color:var(--gold2); line-height:.9; text-shadow:0 0 60px rgba(212,175,55,.25);
  }
  .rb-label { font-family:var(--font-mono); font-size:11px; color:var(--muted); letter-spacing:3px; text-transform:uppercase; margin-top:8px; }
  .rb-from { margin-top:20px; padding-top:20px; border-top:1px solid rgba(212,175,55,.15); font-size:14px; color:var(--gold3); font-weight:600; letter-spacing:.5px; }

  .rb-points { display:flex; flex-direction:column; gap:18px; }
  .rp { background:var(--black); border:1px solid rgba(212,175,55,.1); border-radius:8px; padding:18px 22px; display:flex; gap:14px; align-items:flex-start; transition:border-color .2s; }
  .rp:hover { border-color:rgba(212,175,55,.35); }
  .rp-num { font-family:var(--font-display); font-size:42px; color:rgba(212,175,55,.15); line-height:1; flex-shrink:0; width:38px; }
  .rp-t { font-size:14px; font-weight:600; margin-bottom:4px; }
  .rp-p { font-size:13px; color:var(--muted); line-height:1.55; }

  /* CALCULADORA */
  #calculadora { padding:80px 0 120px; background:var(--black); }
  #at-calc { background:var(--dark); border:1px solid rgba(212,175,55,.3); border-radius:14px; padding:32px 32px 36px; color:var(--white); }
  #at-calc * { box-sizing:border-box; }
  #at-calc .ac-grid2 { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px; }
  @media(max-width:640px){ #at-calc .ac-grid2 { grid-template-columns:1fr; } }
  #at-calc .ac-card { background:var(--black); border:1px solid rgba(212,175,55,.15); border-radius:8px; padding:1rem 1.25rem; }
  #at-calc .ac-card.at { border-left:3px solid var(--gold2); }
  #at-calc .ac-card.riv { border-left:3px solid var(--red); }
  #at-calc .ac-name { font-family:var(--font-display); font-size:17px; font-weight:700; margin-bottom:14px; }
  #at-calc .ac-row { display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; }
  #at-calc .ac-lbl { font-size:13px; color:var(--muted); }
  #at-calc .ac-group { display:flex; align-items:center; gap:6px; }
  #at-calc .ac-input { width:72px; padding:5px 8px; font-size:14px; font-weight:600; text-align:right; border:1px solid rgba(212,175,55,.3); border-radius:6px; background:var(--black); color:var(--white); font-family:var(--font-mono); }
  #at-calc .ac-input:focus { outline:none; border-color:var(--gold2); }
  #at-calc .ac-unit { font-size:12px; color:var(--muted); }
  #at-calc .ac-vol { background:var(--black); border:1px solid rgba(212,175,55,.15); border-radius:8px; padding:1rem 1.25rem; margin-bottom:16px; }
  #at-calc .ac-vol-title { font-family:var(--font-mono); font-size:10px; color:var(--gold); letter-spacing:3px; text-transform:uppercase; margin-bottom:12px; }
  #at-calc .ac-sl-row { display:flex; align-items:center; gap:12px; margin-bottom:14px; }
  #at-calc .ac-sl-lbl { font-size:13px; color:var(--muted); min-width:170px; }
  #at-calc .ac-sl-val { font-size:14px; font-weight:600; font-family:var(--font-mono); color:var(--gold2); min-width:64px; text-align:right; }
  #at-calc input[type=range] { flex:1; -webkit-appearance:none; height:4px; background:rgba(212,175,55,.25); border-radius:2px; cursor:pointer; }
  #at-calc input[type=range]::-webkit-slider-thumb { -webkit-appearance:none; width:16px; height:16px; border-radius:50%; background:var(--gold2); cursor:pointer; }
  #at-calc .ac-metrics { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin:16px 0; }
  @media(max-width:640px){ #at-calc .ac-metrics { grid-template-columns:1fr; } }
  #at-calc .ac-metric { background:var(--black); border:1px solid rgba(212,175,55,.12); border-radius:8px; padding:14px; text-align:center; }
  #at-calc .ac-mlbl { font-size:11px; color:var(--muted); margin-bottom:6px; font-family:var(--font-mono); text-transform:uppercase; letter-spacing:.05em; }
  #at-calc .ac-mval { font-family:var(--font-display); font-size:24px; font-weight:800; letter-spacing:.5px; }
  #at-calc .ac-mval.green { color:var(--gold2); }
  #at-calc .ac-mval.red { color:var(--red); }
  #at-calc .ac-banner { border-radius:8px; padding:14px 18px; margin:16px 0; font-size:14px; font-weight:600; text-align:center; }
  #at-calc .ac-banner.at-win { background:rgba(212,175,55,.1); color:var(--gold3); border:1px solid rgba(212,175,55,.3); }
  #at-calc .ac-banner.riv-win { background:rgba(224,84,75,.1); color:#FF8A80; border:1px solid rgba(224,84,75,.3); }
  #at-calc .ac-tabs { display:flex; gap:4px; margin-bottom:12px; }
  #at-calc .ac-tab { padding:6px 14px; font-size:12px; border-radius:6px; border:1px solid rgba(212,175,55,.2); background:transparent; color:var(--muted); cursor:pointer; font-family:var(--font-mono); transition:all .2s; }
  #at-calc .ac-tab.active { background:var(--black); color:var(--gold2); border-color:var(--gold2); font-weight:600; }
  #at-calc .ac-chart-wrap { position:relative; width:100%; height:240px; margin-top:8px; }
  #at-calc .ac-tbl { width:100%; font-size:13px; border-collapse:collapse; }
  #at-calc .ac-tbl th { text-align:right; padding:8px 10px; color:var(--muted); font-weight:500; font-family:var(--font-mono); font-size:11px; text-transform:uppercase; letter-spacing:.05em; border-bottom:1px solid rgba(212,175,55,.15); }
  #at-calc .ac-tbl th:first-child { text-align:left; }
  #at-calc .ac-tbl td { text-align:right; padding:8px 10px; border-bottom:1px solid rgba(212,175,55,.1); color:var(--white); }
  #at-calc .ac-tbl td:first-child { text-align:left; color:var(--muted); }
  #at-calc .ac-tbl td.green { color:var(--gold2); font-weight:600; }
  #at-calc .ac-tbl td.red { color:var(--red); }
  #at-calc .ac-tbl tr.hl td { background:rgba(212,175,55,.05); }

  /* BONUS */
  #bonus { padding:120px 0; background:var(--dark); }
  .bonus-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:2px; margin-top:56px; border-radius:10px; overflow:hidden; }
  .bonus-card { background:var(--black); border:1px solid rgba(212,175,55,.1); padding:36px 28px; position:relative; overflow:hidden; transition:border-color .25s; }
  .bonus-card::before { content:''; position:absolute; top:0; left:0; right:0; height:2px; background:linear-gradient(90deg,transparent,var(--gold),transparent); opacity:0; transition:opacity .25s; }
  .bonus-card:hover::before { opacity:1; }
  .bonus-card:hover { border-color:rgba(212,175,55,.35); }
  .bonus-badge { display:inline-block; background:rgba(212,175,55,.1); color:var(--gold3); border:1px solid rgba(212,175,55,.25); border-radius:20px; padding:4px 12px; font-family:var(--font-mono); font-size:10px; letter-spacing:1px; text-transform:uppercase; margin-bottom:16px; }
  .bonus-amount { font-family:var(--font-display); font-size:46px; font-weight:800; color:var(--white); line-height:1; margin-bottom:8px; }
  .bonus-amount .gold { color:var(--gold2); }
  .bonus-title { font-size:15px; font-weight:600; margin-bottom:10px; }
  .bonus-card p { font-size:13px; color:var(--muted); line-height:1.6; }

  /* BLOG PREVIEW */
  #blog { padding:120px 0; background:var(--black); }
  .blog-header-row { display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:20px; margin-bottom:8px; }
  .blog-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; margin-top:48px; }
  .blog-card {
    background:var(--dark); border:1px solid rgba(212,175,55,.12);
    border-radius:12px; overflow:hidden; text-decoration:none; color:var(--white);
    display:flex; flex-direction:column; transition:all .25s;
  }
  .blog-card:hover { border-color:rgba(212,175,55,.4); transform:translateY(-4px); }
  .blog-img {
    width:100%; aspect-ratio:16/10; background:linear-gradient(135deg, rgba(212,175,55,.15), rgba(13,13,13,.4));
    display:flex; align-items:center; justify-content:center;
    border-bottom:1px solid rgba(212,175,55,.12);
    position:relative; overflow:hidden;
  }
  .blog-img-icon { font-size:36px; opacity:.3; }
  .blog-cat {
    position:absolute; top:14px; left:14px;
    background:rgba(13,13,13,.85); border:1px solid rgba(212,175,55,.4);
    color:var(--gold3); font-family:var(--font-mono); font-size:10px;
    letter-spacing:1px; text-transform:uppercase; padding:4px 10px; border-radius:20px;
  }
  .blog-body { padding:22px 22px 24px; display:flex; flex-direction:column; flex:1; }
  .blog-date { font-family:var(--font-mono); font-size:11px; color:var(--muted); margin-bottom:10px; letter-spacing:.5px; }
  .blog-title { font-family:var(--font-display); font-size:18px; font-weight:700; line-height:1.3; margin-bottom:10px; }
  .blog-excerpt { font-size:13px; color:var(--muted); line-height:1.6; flex:1; margin-bottom:14px; }
  .blog-readmore { font-size:13px; font-weight:600; color:var(--gold2); display:flex; align-items:center; gap:6px; }

  /* COMO ENTRAR */
  #como { padding:120px 0; background:var(--dark); }
  .steps-row { display:grid; grid-template-columns:repeat(4,1fr); gap:2px; margin:56px 0 48px; border-radius:10px; overflow:hidden; }
  .step { background:var(--black); border:1px solid rgba(212,175,55,.1); padding:36px 26px; position:relative; transition:all .25s; }
  .step:hover { background:var(--dark2); border-color:rgba(212,175,55,.3); }
  .step::after { content:'→'; position:absolute; right:-12px; top:50%; transform:translateY(-50%); color:var(--gold); font-size:18px; z-index:2; }
  .step:last-child::after { display:none; }
  .step-num { font-family:var(--font-display); font-size:60px; font-weight:800; color:rgba(212,175,55,.1); line-height:1; margin-bottom:14px; }
  .step-title { font-size:14px; font-weight:700; margin-bottom:8px; }
  .step p { font-size:13px; color:var(--muted); line-height:1.6; }

  /* CTA FINAL */
  #cta-final { padding:140px 0; background:radial-gradient(ellipse 70% 70% at 50% 50%, rgba(212,175,55,.08) 0%, transparent 70%), var(--black); text-align:center; }
  .cf-headline { font-family:var(--font-display); font-weight:800; font-size:clamp(42px,5.5vw,68px); line-height:1.02; letter-spacing:-.5px; margin-bottom:20px; }
  .cf-headline .gold { color:var(--gold2); }
  .cf-sub { font-size:17px; color:var(--muted); margin-bottom:44px; max-width:460px; margin-left:auto; margin-right:auto; }
  .cf-btns { display:flex; gap:16px; justify-content:center; flex-wrap:wrap; }

  /* FOOTER */
