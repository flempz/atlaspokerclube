<!-- ══ CALCULADORA JS ══ -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
(function(){
  let chart = null;
  function v(id){ return parseFloat(document.getElementById(id).value)||0; }
  function calcNet(rakeRate,rbRate,capBB,pot,handsHr,hrsWk,bb){
    const gross = Math.min(pot*(rakeRate/100), capBB*bb);
    const net   = gross*(1-(rbRate/100));
    return { gross, net, perWeek: net*handsHr*hrsWk };
  }
  function fmt(n){ return '$'+Math.abs(n).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2}); }

  function compute(){
    const pot=v('ac-pot'), handsHr=v('ac-hands'), hrsWk=v('ac-hrs'), bb=v('ac-bb');
    const at = calcNet(v('at-rake'),v('at-rb'),v('at-cap'),pot,handsHr,hrsWk,bb);
    const rv = calcNet(v('rv-rake'),v('rv-rb'),v('rv-cap'),pot,handsHr,hrsWk,bb);
    const atM = at.perWeek*4.33, rvM = rv.perWeek*4.33;
    const saving = rvM-atM, pct = rvM>0?(saving/rvM*100):0;

    let reason='';
    const atRb=v('at-rb'),rvRb=v('rv-rb'),atRake=v('at-rake'),rvRake=v('rv-rake');
    if(atRb>=rvRb&&atRake<=rvRake) reason='com rake menor E rakeback maior';
    else if(atRb>=rvRb) reason=`com rakeback maior (${atRb}% vs ${rvRb}%)`;
    else if(atRake<=rvRake) reason=`graças ao rake mais baixo (${atRake}% vs ${rvRake}%)`;
    else reason=`mesmo com rakeback menor (${atRb}% vs ${rvRb}%)`;

    const bannerCls = saving>=0?'at-win':'riv-win';
    const bannerTxt = saving>=0
      ? `✓ Atlas Poker Clube é ${Math.abs(pct).toFixed(1)}% mais barato — você economiza ${fmt(saving)}/mês ${reason}`
      : `⚠ Com esses valores o Concorrente sai mais barato. Ajuste os parâmetros.`;

    document.getElementById('ac-metrics').innerHTML = `
      <div class="ac-metrics">
        <div class="ac-metric"><div class="ac-mlbl">Custo líquido Atlas / mês</div><div class="ac-mval ${atM<=rvM?'green':'red'}">${fmt(atM)}</div></div>
        <div class="ac-metric"><div class="ac-mlbl">Custo líquido Concorrente / mês</div><div class="ac-mval ${rvM<atM?'green':'red'}">${fmt(rvM)}</div></div>
        <div class="ac-metric"><div class="ac-mlbl">Economia mensal no Atlas</div><div class="ac-mval ${saving>=0?'green':'red'}">${saving>=0?'':'-'}${fmt(saving)}</div></div>
      </div>
      <div class="ac-banner ${bannerCls}">${bannerTxt}</div>
    `;

    const labels = Array.from({length:12},(_,i)=>`Mês ${i+1}`);
    const atCum  = labels.map((_,i)=>+(atM*(i+1)).toFixed(2));
    const rvCum  = labels.map((_,i)=>+(rvM*(i+1)).toFixed(2));
    updateChart(labels,atCum,rvCum);
    updateTable(atM,rvM);
  }

  function updateChart(labels,atCum,rvCum){
    const ctx = document.getElementById('ac-canvas').getContext('2d');
    if(chart) chart.destroy();
    chart = new Chart(ctx,{
      type:'line',
      data:{ labels, datasets:[
        { label:'Atlas Poker Clube', data:atCum, borderColor:'#E8C766', backgroundColor:'rgba(212,175,55,.08)', fill:true, tension:.3, pointRadius:3, borderWidth:2 },
        { label:'Concorrente', data:rvCum, borderColor:'#E0544B', backgroundColor:'rgba(224,84,75,.08)', fill:true, tension:.3, pointRadius:3, borderWidth:2, borderDash:[5,4] }
      ]},
      options:{
        responsive:true, maintainAspectRatio:false,
        plugins:{
          legend:{ display:true, labels:{ color:'#9A9A9A', font:{size:12,family:"'DM Mono',monospace"}, boxWidth:14, padding:14 } },
          tooltip:{ backgroundColor:'#1A1A1A', borderColor:'rgba(212,175,55,.3)', borderWidth:1, titleColor:'#9A9A9A', bodyColor:'#FFFFFF',
            callbacks:{ label: c=>' '+c.dataset.label+': $'+c.parsed.y.toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2}) } }
        },
        scales:{
          y:{ ticks:{ callback:v=>'$'+v.toLocaleString('pt-BR',{minimumFractionDigits:0}), font:{size:11,family:"'DM Mono',monospace"}, color:'#9A9A9A' }, grid:{ color:'rgba(212,175,55,.07)' }, border:{ color:'rgba(212,175,55,.15)' } },
          x:{ ticks:{ font:{size:11,family:"'DM Mono',monospace"}, color:'#9A9A9A', autoSkip:false, maxRotation:0 }, grid:{ display:false }, border:{ color:'rgba(212,175,55,.15)' } }
        }
      }
    });
  }

  function updateTable(atM,rvM){
    const grossPerHand = Math.min(v('ac-pot')*(v('rv-rake')/100), v('rv-cap')*v('ac-bb'));
    const rawGross = grossPerHand*v('ac-hands')*v('ac-hrs')*4.33;
    const periods = [
      {label:'1 semana', mult:1/4.33}, {label:'1 mês', mult:1}, {label:'3 meses', mult:3},
      {label:'6 meses', mult:6}, {label:'12 meses', mult:12},
    ];
    let rows='';
    periods.forEach((p,i)=>{
      const gross=rawGross*p.mult, at=atM*p.mult, rv=rvM*p.mult, diff=rv-at;
      rows+=`<tr class="${i%2===0?'hl':''}">
        <td>${p.label}</td><td>${fmt(gross)}</td><td class="green">${fmt(at)}</td><td class="red">${fmt(rv)}</td>
        <td class="${diff>=0?'green':'red'}">${diff>=0?'+':'-'}${fmt(diff)}</td>
      </tr>`;
    });
    document.getElementById('ac-tbody').innerHTML=rows;
  }

  window.acTab=function(tab,btn){
    document.querySelectorAll('#at-calc .ac-tab').forEach(t=>t.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('ac-chart-wrap').style.display = tab==='chart'?'':'none';
    document.getElementById('ac-table-wrap').style.display = tab==='table'?'':'none';
  };

  function bindSl(id,outId,fmtFn){
    const el=document.getElementById(id), out=document.getElementById(outId);
    el.addEventListener('input',()=>{ out.textContent=fmtFn(el.value); compute(); });
  }
  bindSl('ac-pot','ac-pot-out', v=>'$'+v);
  bindSl('ac-hands','ac-hands-out', v=>v);
  bindSl('ac-hrs','ac-hrs-out', v=>v+' h');
  bindSl('ac-bb','ac-bb-out', v=>'$'+parseFloat(v).toFixed(2));
  ['at-rake','at-rb','at-cap','rv-rake','rv-rb','rv-cap'].forEach(id=>{
    document.getElementById(id).addEventListener('input',compute);
  });
  compute();
})();
</script>

<script>
  if (!CSS.supports('animation-timeline','scroll()')) {
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.08 });
    document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
  }
</script>

</body>
</html>